{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/booking/",
      "destination": "/booking",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/booking",
      "destination": "https://degup-request.vercel.app/booking"
    },
    {
      "source": "/booking/:path*",
      "destination": "https://degup-request.vercel.app/booking/:path*"
    }
  ]
}
